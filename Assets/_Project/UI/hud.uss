.root {
    flex-grow: 1;
}

.top-right {
    position: absolute;
    top: 24px;
    right: 24px;
    flex-direction: column;
    align-items: flex-end;
}

.menu-button {
    width: 180px;
    height: 46px;
    margin-top: 6px;
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(139, 139, 139);
    border-width: 3px;
    border-top-color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    border-bottom-color: rgb(85, 85, 85);
    border-right-color: rgb(85, 85, 85);
    border-radius: 0;
}

.menu-button:hover {
    background-color: rgb(160, 160, 160);
}

.bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

.bar {
    flex-direction: row;
    align-items: center;
    background-color: rgba(198, 198, 198, 0.92);
    border-top-width: 4px;
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(85, 85, 85);
    padding: 8px;
}

.portrait-column {
    align-items: center;
}

.exp-bar {
    width: 96px;
    height: 10px;
    margin-top: 4px;
    background-color: rgb(60, 60, 60);
    border-width: 2px;
    border-top-color: rgb(55, 55, 55);
    border-left-color: rgb(55, 55, 55);
    border-bottom-color: rgb(198, 198, 198);
    border-right-color: rgb(198, 198, 198);
    overflow: hidden;
}

.exp-fill {
    height: 100%;
    width: 0;
    background-color: rgb(90, 170, 230);
}

.level-value {
    color: rgb(40, 40, 40);
    font-size: 15px;
    -unity-font-style: bold;
    margin-top: 2px;
}

.portrait {
    width: 96px;
    height: 96px;
    background-color: rgb(90, 90, 100);
    border-width: 3px;
    border-top-color: rgb(55, 55, 55);
    border-left-color: rgb(55, 55, 55);
    border-bottom-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
}

.bar-stats {
    width: 150px;
    margin-left: 10px;
    margin-right: 10px;
}

.bar-stat {
    color: rgb(40, 40, 40);
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.hp-column {
    width: 300px;
    margin-right: 12px;
    align-items: center;
}

.hp-bar {
    width: 100%;
    height: 30px;
    background-color: rgb(60, 60, 60);
    border-width: 3px;
    border-top-color: rgb(55, 55, 55);
    border-left-color: rgb(55, 55, 55);
    border-bottom-color: rgb(198, 198, 198);
    border-right-color: rgb(198, 198, 198);
    overflow: hidden;
}

.hp-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(190, 40, 40);
}

.boss-panel {
    position: absolute;
    top: 24px;
    left: 0;
    right: 0;
    display: none;
    align-items: center;
}

.boss-name {
    color: rgb(255, 255, 255);
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 4px;
}

.boss-bar {
    width: 640px;
    height: 26px;
    background-color: rgb(60, 60, 60);
    border-width: 3px;
    border-top-color: rgb(55, 55, 55);
    border-left-color: rgb(55, 55, 55);
    border-bottom-color: rgb(198, 198, 198);
    border-right-color: rgb(198, 198, 198);
    overflow: hidden;
}

.boss-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(150, 30, 30);
}

.mana-bar {
    width: 100%;
    height: 20px;
    margin-top: 4px;
    background-color: rgb(60, 60, 60);
    border-width: 3px;
    border-top-color: rgb(55, 55, 55);
    border-left-color: rgb(55, 55, 55);
    border-bottom-color: rgb(198, 198, 198);
    border-right-color: rgb(198, 198, 198);
    overflow: hidden;
}

.mana-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(50, 110, 210);
}

.ability-row {
    flex-direction: row;
    justify-content: center;
    margin-top: 6px;
}

.ability-button {
    width: 64px;
    height: 64px;
    margin-left: 4px;
    margin-right: 4px;
    padding: 0;
    background-color: rgb(139, 139, 139);
    border-width: 3px;
    border-top-color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    border-bottom-color: rgb(85, 85, 85);
    border-right-color: rgb(85, 85, 85);
    border-radius: 0;
    overflow: hidden;
}

.ability-button:hover {
    background-color: rgb(160, 160, 160);
}

/* нет маны — иконка гаснет, кнопка остаётся нажимаемой (тап всё равно ничего не сделает) */
.ability-button--empty .ability-icon {
    opacity: 0.35;
}

.ability-icon {
    position: absolute;
    left: 4px;
    right: 4px;
    top: 4px;
    bottom: 4px;
    -unity-background-scale-mode: scale-to-fit;
}

.ability-cooldown {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 0;
    background-color: rgba(0, 0, 0, 0.6);
}

.ability-timer {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: rgb(255, 255, 255);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hp-text {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: rgb(255, 255, 255);
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.hp-regen {
    position: absolute;
    right: 8px;
    top: 0;
    bottom: 0;
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
}

.equipment-grid {
    width: 246px;
}

.backpack-column {
    align-items: center;
    margin-left: 8px;
}

.gold-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.gold-icon {
    width: 40px;
    height: 40px;
    margin-right: 8px;
    background-image: url("project://database/Assets/_Project/Sprite/UI/coins_inapp.png#coins_inapp_1");
    -unity-background-scale-mode: scale-to-fit;
}

.gold-value {
    color: rgb(40, 40, 40);
    font-size: 28px;
    -unity-font-style: bold;
}

.backpack-toggle {
    width: 76px;
    height: 76px;
    padding: 0;
    align-items: center;
    justify-content: center;
    background-color: rgb(139, 139, 139);
    border-width: 3px;
    border-top-color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    border-bottom-color: rgb(85, 85, 85);
    border-right-color: rgb(85, 85, 85);
    border-radius: 0;
}

.backpack-toggle:hover {
    background-color: rgb(160, 160, 160);
}

/* открытый рюкзак — кнопка выглядит вдавленной: фаска вывернута наизнанку */
.backpack-toggle--open {
    background-color: rgb(120, 120, 120);
    border-top-color: rgb(55, 55, 55);
    border-left-color: rgb(55, 55, 55);
    border-bottom-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
}

.backpack-icon {
    width: 57px;
    height: 57px;
    background-image: url("project://database/Assets/Cainos/Pixel%20Art%20Icon%20Pack%20-%20RPG/Texture/Equipment/Bag.png");
    -unity-background-scale-mode: scale-to-fit;
}

.backpack-panel {
    display: none;
    position: absolute;
    left: 100%;
    bottom: 0;
    background-color: rgba(198, 198, 198, 0.96);
    border-width: 4px;
    border-top-color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    border-bottom-color: rgb(85, 85, 85);
    border-right-color: rgb(85, 85, 85);
    padding: 10px;
    margin-left: 8px;
}

.backpack-grid {
    width: 246px;
}

.backpack-title {
    color: rgb(64, 64, 64);
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.root {
    flex-grow: 1;
}

.top-right {
    position: absolute;
    top: 24px;
    right: 24px;
    flex-direction: column;
    align-items: flex-end;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    width: 180px;
    margin-bottom: 6px;
}

.stat-label {
    color: rgb(210, 210, 210);
    font-size: 20px;
    -unity-font-style: bold;
}

.stat-value {
    color: rgb(255, 214, 64);
    font-size: 22px;
    -unity-font-style: bold;
}

.menu-button {
    width: 180px;
    height: 46px;
    margin-top: 6px;
    font-size: 17px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(139, 139, 139);
    border-width: 3px;
    border-top-color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    border-bottom-color: rgb(85, 85, 85);
    border-right-color: rgb(85, 85, 85);
    border-radius: 0;
}

.menu-button:hover {
    background-color: rgb(160, 160, 160);
}

.bottom {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    flex-direction: row;
    justify-content: center;
    align-items: flex-end;
}

.bar {
    flex-direction: row;
    align-items: center;
    background-color: rgba(198, 198, 198, 0.92);
    border-top-width: 4px;
    border-left-width: 4px;
    border-right-width: 4px;
    border-top-color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(85, 85, 85);
    padding: 8px;
}

.portrait {
    width: 96px;
    height: 96px;
    background-color: rgb(90, 90, 100);
    border-width: 3px;
    border-top-color: rgb(55, 55, 55);
    border-left-color: rgb(55, 55, 55);
    border-bottom-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
}

.bar-stats {
    width: 150px;
    margin-left: 10px;
    margin-right: 10px;
}

.bar-stat {
    color: rgb(40, 40, 40);
    font-size: 15px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.hp-column {
    width: 300px;
    margin-right: 12px;
    align-items: center;
}

.hp-bar {
    width: 100%;
    height: 26px;
    background-color: rgb(60, 60, 60);
    border-width: 3px;
    border-top-color: rgb(55, 55, 55);
    border-left-color: rgb(55, 55, 55);
    border-bottom-color: rgb(198, 198, 198);
    border-right-color: rgb(198, 198, 198);
    overflow: hidden;
}

.hp-fill {
    height: 100%;
    width: 100%;
    background-color: rgb(190, 40, 40);
}

.hp-text {
    color: rgb(40, 40, 40);
    font-size: 15px;
    -unity-font-style: bold;
    margin-top: 2px;
}

.equipment-grid {
    width: 246px;
}

.backpack-toggle {
    width: 64px;
    height: 78px;
    margin-left: 8px;
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(139, 139, 139);
    border-width: 3px;
    border-top-color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    border-bottom-color: rgb(85, 85, 85);
    border-right-color: rgb(85, 85, 85);
    border-radius: 0;
    white-space: normal;
}

.backpack-toggle:hover {
    background-color: rgb(160, 160, 160);
}

.backpack-panel {
    display: none;
    position: absolute;
    left: 100%;
    bottom: 0;
    background-color: rgba(198, 198, 198, 0.96);
    border-width: 4px;
    border-top-color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    border-bottom-color: rgb(85, 85, 85);
    border-right-color: rgb(85, 85, 85);
    padding: 10px;
    margin-left: 8px;
}

.backpack-grid {
    width: 246px;
}

.backpack-title {
    color: rgb(64, 64, 64);
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/_Project/UI/character.uss" />
    <ui:VisualElement name="root" class="root" picking-mode="Ignore">
        <ui:VisualElement name="window" class="window">
            <ui:VisualElement name="header" class="header">
                <ui:Label name="title" class="title" picking-mode="Ignore" />
                <ui:Button name="close" text="X" class="close" />
            </ui:VisualElement>

            <ui:VisualElement name="body" class="body">
                <ui:VisualElement name="stats" class="stats" picking-mode="Ignore">
                    <ui:Label name="stats-title" class="section-title" picking-mode="Ignore" />
                    <ui:Label name="stat-health" class="stat" picking-mode="Ignore" />
                    <ui:Label name="stat-damage" class="stat" picking-mode="Ignore" />
                    <ui:Label name="stat-physical" class="stat" picking-mode="Ignore" />
                    <ui:Label name="stat-magic" class="stat" picking-mode="Ignore" />
                    <ui:Label name="stat-fire" class="stat" picking-mode="Ignore" />
                    <ui:Label name="stat-faith" class="stat" picking-mode="Ignore" />
                </ui:VisualElement>

                <ui:VisualElement name="right" class="right">
                    <ui:Label name="equipment-title" class="section-title" picking-mode="Ignore" />
                    <ui:VisualElement name="equipment" class="slot-grid" />
                    <ui:Label name="backpack-title" class="section-title" picking-mode="Ignore" />
                    <ui:VisualElement name="backpack" class="slot-grid" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="tooltip" class="tooltip" picking-mode="Ignore">
            <ui:Label name="tooltip-title" class="tooltip-title" picking-mode="Ignore" />
            <ui:Label name="tooltip-body" class="tooltip-body" picking-mode="Ignore" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

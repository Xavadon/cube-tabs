.slot-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.slot {
    width: 76px;
    height: 76px;
    margin-right: 6px;
    margin-bottom: 6px;
    background-color: rgb(139, 139, 139);
    border-width: 3px;
    border-top-color: rgb(55, 55, 55);
    border-left-color: rgb(55, 55, 55);
    border-bottom-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-radius: 0;
    align-items: center;
    justify-content: center;
}

.slot-empty {
    background-color: rgb(120, 120, 120);
}

.slot-hover {
    background-color: rgb(200, 200, 200);
}

.slot-icon {
    width: 56px;
    height: 56px;
}

.slot-label {
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.tooltip {
    position: absolute;
    display: none;
    max-width: 340px;
    background-color: rgb(198, 198, 198);
    border-width: 4px;
    border-top-color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    border-bottom-color: rgb(85, 85, 85);
    border-right-color: rgb(85, 85, 85);
    border-radius: 0;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 8px;
    padding-right: 8px;
}

.tooltip-title {
    color: rgb(40, 40, 40);
    font-size: 17px;
    -unity-font-style: bold;
    margin-bottom: 2px;
    white-space: normal;
}

.tooltip-body {
    color: rgb(90, 90, 90);
    font-size: 15px;
    white-space: normal;
}

.ghost {
    position: absolute;
    width: 76px;
    height: 76px;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
}

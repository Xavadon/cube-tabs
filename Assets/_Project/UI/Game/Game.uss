.hud__surrender {
    position: absolute;
    top: var(--space-edge);
    left: var(--space-edge);
}

.hud__top-right {
    position: absolute;
    top: var(--space-edge);
    right: var(--corner-reserve);
    flex-direction: row;
    align-items: flex-start;
}

.hud__button {
    margin-left: var(--space-s);
}

.hud__timer {
    height: var(--icon-button-size);
    padding: 0 var(--space-s);
}

.hud__timer > .icon {
    margin-right: var(--space-xs);
}

.wave-banner {
    position: absolute;
    left: 0;
    right: 0;
    top: 22%;
    align-items: center;
}

.wave-banner__title {
    font-size: var(--font-size-xl);
    color: var(--color-gold);
    text-shadow: 5px 5px 0 var(--color-text-shadow);
}

.wave-banner__subtitle {
    font-size: var(--font-size-l);
}

.result__sun {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 1100px;
    height: 1100px;
    translate: -50% -50%;
    background-image: url("/Assets/_Project/Sprite/UI/reward-sun.png#reward-sun");
    -unity-background-scale-mode: scale-to-fit;
}

.result__panel {
    width: 720px;
    align-items: center;
}

.result__title {
    font-size: var(--font-size-xl);
    margin-bottom: var(--space-m);
}

.result__gold {
    margin-bottom: var(--space-m);
}

.result__gold-value {
    margin-left: var(--space-s);
    color: var(--color-gold);
}

.result__units {
    align-items: center;
    margin-bottom: var(--space-l);
}

.result__units-list {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-s);
}

.reward-unit {
    margin: 0 var(--space-xs);
}

.reward-unit__count {
    position: absolute;
    right: 0;
    bottom: 0;
    color: var(--color-gold);
}

.result__main-button {
    min-width: 420px;
    height: 96px;
    font-size: var(--font-size-l);
    margin-bottom: var(--space-s);
}

.result__slots {
    color: var(--color-gold);
}

.result__secondary-button {
    min-width: 280px;
    margin: 0 var(--space-xs);
    font-size: var(--font-size-s);
}

.compact .result__sun {
    width: 800px;
    height: 800px;
}

.compact .result__panel {
    max-width: 100%;
}

.compact .reward-unit {
    width: 96px;
    height: 96px;
}

.touch #camera-button {
    display: none;
}

.camera-gestures {
    display: none;
}

.touch .camera-gestures {
    display: flex;
}

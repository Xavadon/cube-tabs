.root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.window {
    width: 860px;
    background-color: rgb(198, 198, 198);
    border-width: 4px;
    border-top-color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    border-bottom-color: rgb(85, 85, 85);
    border-right-color: rgb(85, 85, 85);
    border-radius: 0;
    padding: 14px;
}

.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.title {
    color: rgb(64, 64, 64);
    font-size: 26px;
    -unity-font-style: bold;
}

.close {
    width: 40px;
    height: 40px;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(139, 139, 139);
    border-width: 3px;
    border-top-color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    border-bottom-color: rgb(85, 85, 85);
    border-right-color: rgb(85, 85, 85);
    border-radius: 0;
}

.close:hover {
    background-color: rgb(160, 160, 160);
}

.body {
    flex-direction: row;
}

.stats {
    width: 280px;
    margin-right: 20px;
    background-color: rgb(139, 139, 139);
    border-width: 3px;
    border-top-color: rgb(55, 55, 55);
    border-left-color: rgb(55, 55, 55);
    border-bottom-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    padding: 10px;
}

.right {
    flex-grow: 1;
}

.section-title {
    color: rgb(64, 64, 64);
    font-size: 18px;
    -unity-font-style: bold;
    margin-top: 6px;
    margin-bottom: 6px;
}

.stat {
    color: rgb(255, 255, 255);
    font-size: 17px;
    margin-bottom: 5px;
}

.slot-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.slot {
    width: 76px;
    height: 76px;
    margin-right: 6px;
    margin-bottom: 6px;
    background-color: rgb(139, 139, 139);
    border-width: 3px;
    border-top-color: rgb(55, 55, 55);
    border-left-color: rgb(55, 55, 55);
    border-bottom-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-radius: 0;
    align-items: center;
    justify-content: center;
}

.slot-empty {
    background-color: rgb(139, 139, 139);
}

.slot-hover {
    background-color: rgb(200, 200, 200);
}

.slot-icon {
    width: 56px;
    height: 56px;
}

.slot-label {
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-text-align: middle-center;
    white-space: normal;
}

.tooltip {
    position: absolute;
    display: none;
    max-width: 320px;
    background-color: rgb(16, 0, 16);
    border-width: 3px;
    border-color: rgb(45, 0, 100);
    border-radius: 0;
    padding: 8px;
}

.tooltip-title {
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 4px;
    white-space: normal;
}

.tooltip-body {
    color: rgb(170, 170, 170);
    font-size: 16px;
    white-space: normal;
}

.ghost {
    position: absolute;
    width: 76px;
    height: 76px;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
}

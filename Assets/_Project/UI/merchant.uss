.root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.window {
    width: 900px;
    height: 680px;
    margin-bottom: 180px;
    background-color: rgb(198, 198, 198);
    border-width: 4px;
    border-top-color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    border-bottom-color: rgb(85, 85, 85);
    border-right-color: rgb(85, 85, 85);
    border-radius: 0;
    padding: 14px;
}

.header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
}

.title {
    color: rgb(64, 64, 64);
    font-size: 26px;
    -unity-font-style: bold;
}

.gold {
    color: rgb(64, 64, 64);
    font-size: 20px;
    -unity-font-style: bold;
}

.close {
    width: 40px;
    height: 40px;
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgb(139, 139, 139);
    border-width: 3px;
    border-top-color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    border-bottom-color: rgb(85, 85, 85);
    border-right-color: rgb(85, 85, 85);
    border-radius: 0;
}

.close:hover {
    background-color: rgb(160, 160, 160);
}

.body {
    flex-direction: row;
    flex-grow: 1;
}

.column {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 14px;
}

.section-title {
    color: rgb(64, 64, 64);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 6px;
}

.section-title--second {
    margin-top: 12px;
}

.list {
    flex-grow: 1;
    align-content: flex-start;
    background-color: rgb(139, 139, 139);
    border-width: 3px;
    border-top-color: rgb(55, 55, 55);
    border-left-color: rgb(55, 55, 55);
    border-bottom-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    padding: 6px;
}

.shop-cell {
    align-self: flex-start;
    border-width: 2px;
    border-top-color: rgba(0, 0, 0, 0);
    border-left-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    padding: 2px;
    margin-right: 4px;
    margin-bottom: 4px;
}

.shop-cell--affordable {
    border-top-color: rgb(232, 195, 74);
    border-left-color: rgb(232, 195, 74);
    border-bottom-color: rgb(232, 195, 74);
    border-right-color: rgb(232, 195, 74);
}

.shop-cell--selected {
    border-top-color: rgb(255, 255, 255);
    border-left-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
}

.shop-cell .slot {
    margin-right: 0;
    margin-bottom: 0;
}

.craft-grid {
    flex-grow: 0;
    width: 276px;
    padding: 6px;
}

.craft-hint {
    color: rgb(90, 90, 90);
    font-size: 14px;
    margin-top: 6px;
    margin-bottom: 10px;
    white-space: normal;
}

.recipe-tree {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    padding: 12px;
}

.tree-row {
    flex-direction: row;
    justify-content: center;
}

.tree-row--parents {
    margin-bottom: 34px;
}

.tree-row--ingredients {
    margin-top: 34px;
}

.tree-hint {
    color: rgb(210, 210, 210);
    font-size: 15px;
    -unity-text-align: middle-center;
    white-space: normal;
}

